.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~
.venv/

# Local workflow state.
# Track durable, repo-visible execution memory; ignore the rest.
.dev/*
!.dev/project.md
!.dev/state.md
!.dev/release-private.md
!.dev/winget-release.md
!.dev/winget-release.zh-tw.md
!.dev/plans/
